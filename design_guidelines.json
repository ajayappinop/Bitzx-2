  "sections": [
    {
      "name": "Hero",
      "type": "hero",
      "layout": "split_asymmetrical",
      "content": {
        "headline": "The Future of Decentralized \u0026 Centralized Exchange",
        "subheadline": "IBO ($IBO) powers the next-gen crypto ecosystem. Secure, fast, and community-driven.",
        "cta_primary": "Buy $IBO Now",
        "cta_secondary": "Read Whitepaper"
      },
      "visuals": {
        "bg_effect": "particles_gold_dust",
        "3d_element": "floating_gold_coin_or_abstract_shape"
      }
    },
    {
      "name": "Stats",
      "type": "stats_ticker",
      "layout": "horizontal_bar",
      "style": "glass_panel_floating"
    },
    {
      "name": "About",
      "type": "feature_split",
      "layout": "image_left_text_right",
      "visuals": {
        "image": "security_feature"
      }
    },
    {
      "name": "Utility",
      "type": "bento_grid",
      "items": [
        {"title": "Staking Rewards", "icon": "Coins", "size": "large"},
        {"title": "Governance", "icon": "Vote", "size": "small"},
        {"title": "Low Fees", "icon": "Percent", "size": "small"},
        {"title": "Exchange Access", "icon": "Building", "size": "tall"}
      ]
    },
    {
      "name": "CEX Exchange Preview",
      "type": "showcase",
      "layout": "centered_focus",
      "visuals": {
        "image": "exchange_preview",
        "effect": "tilt_shift_parallax"
      }
    },
    {
      "name": "Roadmap",
      "type": "timeline",
      "style": "vertical_glowing_nodes"
    },
    {
      "name": "Tokenomics",
      "type": "chart_section",
      "visuals": {
        "chart_type": "donut",
        "library": "recharts"
      }
    },
    {
      "name": "FAQ",
      "type": "accordion",
      "style": "minimal_glass"
    }
  ],
  "technical_instructions": {
    "framework": "React (Create React App structure)",
    "styling": "Tailwind CSS",
    "animation_library": "framer-motion",
    "icons": "lucide-react",
    "charts": "recharts",
    "particles": "react-tsparticles",
    "font_loading": "Import Google Fonts: Outfit (Display) and Plus Jakarta Sans (Body) in index.css",
    "file_extension": "Use .js and .jsx for components"
  },
  "universal_guidelines": [
    "Use 'data-testid' on all interactive elements.",
    "Do not use transparent backgrounds for dropdowns/overlays; use semi-transparent glassmorphism.",
    "Ensure 4.5:1 contrast ratio for text.",
    "Micro-interactions on all hover states.",
    "Mobile-first responsive design."
  ]
}