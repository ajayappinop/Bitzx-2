<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits plain HTTP to the IBO backend server.
  All other traffic still requires HTTPS.
-->
<network-security-config>
  <!-- Dev: allow HTTP to local / LAN backends (release builds should use HTTPS) -->
  <base-config cleartextTrafficPermitted="true" />
  <!-- Production API (HTTPS; listed for explicit trust / legacy IP fallback) -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">api.ibo.io</domain>
    <domain includeSubdomains="true">ibo.io</domain>
  </domain-config>
  <!-- Legacy / staging IP (HTTP only if API_URL points here) -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">207.180.213.153</domain>
  </domain-config>
  <!-- Emulator host loopback + USB adb reverse -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
